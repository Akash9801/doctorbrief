# PostgreSQL connection string (for local Docker Compose or Render Postgres)
DATABASE_URL=postgresql+psycopg://doctorbrief:doctorbrief@localhost:5432/doctorbrief

# Local speech-to-text configuration (faster-whisper)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Security & JWT configuration
SECRET_KEY=replace-with-a-strong-64-char-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_AUDIO_SIZE_MB=25
ENVIRONMENT=development
