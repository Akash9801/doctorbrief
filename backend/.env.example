# PostgreSQL connection string (for local Docker Compose or Render Postgres)
DATABASE_URL=postgresql+psycopg://doctorbrief:doctorbrief@localhost:5432/doctorbrief

# OpenAI API configuration (used for clinical extraction and SOAP generation)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CLINICAL_MODEL=gpt-4o-mini

# Groq API configuration (used for audio transcription via Whisper Large V3 Turbo)
GROQ_API_KEY=your_groq_api_key_here

# Development-only AI mock fallback (set to true ONLY in local dev without an OpenAI key)
ALLOW_DEV_AI_MOCK=false

# Security & JWT configuration
SECRET_KEY=replace-with-a-strong-64-char-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_AUDIO_SIZE_MB=25
ENVIRONMENT=development
